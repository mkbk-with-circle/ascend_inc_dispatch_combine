# User-local CANN 9.0 (ymy only). Never installed under /usr/local/Ascend.
# Usage: INC_USE_CANN_90=1 source docs/inc/configs/910b-yuanmingyu.env
#    or: source scripts/inc_env_910b_cann90.sh

export INC_CANN_USER_ROOT="${INC_CANN_USER_ROOT:-/home/ymy/Ascend}"
export INC_CANN90_HOME="${INC_CANN90_HOME:-$INC_CANN_USER_ROOT/cann-9.0.0}"
