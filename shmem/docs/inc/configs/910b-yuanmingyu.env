# 910B remote profile: yuanmingyu (ymy user)
# Usage: source docs/inc/configs/910b-yuanmingyu.env
#
# CANN policy (do NOT pollute shared system env):
#   - Default: system CANN 8.5 (same as other users on the pod)
#   - Opt-in 9.0: INC_USE_CANN_90=1 source ...  OR  source scripts/inc_env_910b_cann90.sh
#   - 9.0 installs only under /home/ymy/Ascend/cann-9.0.0 (see scripts/install_cann90_user.sh)

export INC_HW_PROFILE=910b-yuanmingyu
export INC_HW_PROFILE_DIR="${INC_HW_PROFILE_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/hardware_profiles/910b-yuanmingyu}"

# shellcheck source=/dev/null
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/cann90-user.env"

_inc_pick_cann() {
  if [ "${INC_USE_CANN_90:-0}" = "1" ] && [ -f "$INC_CANN90_HOME/set_env.sh" ]; then
    export ASCEND_HOME_PATH="$INC_CANN90_HOME"
    export INC_CANN_VERSION=9.0.0
    return
  fi
  if [ -f /usr/local/Ascend/cann-8.5.0/set_env.sh ]; then
    export ASCEND_HOME_PATH=/usr/local/Ascend/cann-8.5.0
    export INC_CANN_VERSION=8.5.0
    return
  fi
  if [ -f "$INC_CANN90_HOME/set_env.sh" ]; then
    export ASCEND_HOME_PATH="$INC_CANN90_HOME"
    export INC_CANN_VERSION=9.0.0
    return
  fi
  export ASCEND_HOME_PATH=/usr/local/Ascend/cann-8.5.0
  export INC_CANN_VERSION=unknown
}
_inc_pick_cann
unset -f _inc_pick_cann

# Gate outputs and P5 baseline for this profile
export INC_REPORT_PROFILE_DIR="$INC_HW_PROFILE_DIR"
export INC_P5_BASELINE="${INC_P5_BASELINE:-$INC_HW_PROFILE_DIR/p5/p5_native_shmem_combine_baseline.json}"
export INC_P5_DISPATCH_BASELINE="${INC_P5_DISPATCH_BASELINE:-$INC_HW_PROFILE_DIR/p5/p5_native_shmem_dispatch_baseline.json}"

# Topology (same as 9rank T1)
PE_SIZE=9
GNPU_NUM=9
FIRST_NPU=0
FIRST_PE=0
INC_IPPORT=tcp://127.0.0.1:8766
INC_SYMMETRIC_HEAP_MB=2048
INC_PROFILING=0
INC_TIMEOUT_SEC=300
INC_TOPOLOGY=single
INC_GATE=first_packet
INC_RS_MODE=full_upload
INC_ENGINE=single_task
INC_RING_DEPTH=4
INC_CHUNK_BYTES=1048576
INC_MAX_INFLIGHT=8

export PE_SIZE GNPU_NUM FIRST_NPU FIRST_PE INC_IPPORT INC_SYMMETRIC_HEAP_MB
export INC_PROFILING INC_TIMEOUT_SEC INC_TOPOLOGY INC_GATE INC_RS_MODE
export INC_ENGINE INC_RING_DEPTH INC_CHUNK_BYTES INC_MAX_INFLIGHT
