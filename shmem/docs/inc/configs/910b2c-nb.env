# Candidate profile for npu-borrow / 910B2C.  Every launcher still validates
# these candidates against the live npu-smi topology before touching an NPU.
# Usage: source docs/inc/configs/910b2c-nb.env

export INC_HW_PROFILE=910b2c-nb
export ASCEND_HOME_PATH=/usr/local/Ascend/cann-9.1.0-beta.3
export INC_CANN_VERSION=9.1.0-beta.3

export INC_SINGLE_INC_PHY=0
export INC_SINGLE_INC_WORKER_PHYS_W2="1 2"
export INC_SINGLE_INC_WORKER_PHYS_W4="1 2 3 4"
export INC_SINGLE_INC_EXPECTED_RELATIONS_W2="HCCS HCCS"
export INC_SINGLE_INC_EXPECTED_RELATIONS_W4="HCCS HCCS HCCS HCCS"

# An 8-card HCCS island cannot contain 8W+1INC.  W8 is deliberately not
# qualified on this profile; leaving it unconfigured makes the live topology
# check fail closed instead of silently accepting a mixed HCCS/PCIe run.
unset INC_SINGLE_INC_WORKER_PHYS_W8
unset INC_SINGLE_INC_EXPECTED_RELATIONS_W8
unset INC_SINGLE_INC_ALLOW_MIXED_TOPOLOGY_W8

# Filled only after formal put-only roofline measurement on this machine.
export INC_SINGLE_INC_PUSH_ROOFLINE_GBPS=""
