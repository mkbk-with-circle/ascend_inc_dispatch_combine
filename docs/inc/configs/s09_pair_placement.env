# S09 T1 pair-aware Phy-ID placement (8 cards x 2 die, 16 Phy-ID total).
# Workers W0-W7 -> Phy 2..9 (four same-card pairs: (2,3)(4,5)(6,7)(8,9))
# Switch S0 -> Phy 10 (die pair with 11, no worker on same card)

export INC_S09_F_NPU="${INC_S09_F_NPU:-2}"
export INC_S09_G_NPUS_INC="${INC_S09_G_NPUS_INC:-9}"
export INC_S09_G_NPUS_SHMEM_RS="${INC_S09_G_NPUS_SHMEM_RS:-8}"
export ACLSHMEM_BARRIER_ALGO="${ACLSHMEM_BARRIER_ALGO:-v1}"
