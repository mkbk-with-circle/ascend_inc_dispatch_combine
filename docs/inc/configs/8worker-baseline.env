# 8-worker SHMEM-direct baseline (no switch ranks)
# Source CANN before use: source ${ASCEND_HOME_PATH}/set_env.sh

PE_SIZE=8
GNPU_NUM=8
FIRST_NPU=0
FIRST_PE=0
INC_IPPORT=tcp://127.0.0.1:8768
INC_SYMMETRIC_HEAP_MB=2048
INC_PROFILING=0
INC_TIMEOUT_SEC=300
INC_TOPOLOGY=direct
INC_GATE=none
INC_RS_MODE=full_upload
INC_ENGINE=direct
INC_RING_DEPTH=4
INC_CHUNK_BYTES=1048576
INC_MAX_INFLIGHT=1
INC_BOUNDED_SPIN_MAX=10000000
INC_S04_READY_SPIN_BUDGET=100000000
INC_S04_ACK_SPIN_BUDGET=1000000000
