# Minimal source sync: omit all reproducible and machine-local artifacts.
- **/build/
- **/build-*/
- **/cmake-build-*/
- **/CMakeFiles/
- **/install/
- *.o
- *.a
- *.so
- *.bin
- *.log
- *.jsonl
- core
- core.*
- __pycache__/
- *.pyc
- cann-packages/
- .local/
- _quarantine/
- **/native/
- **/golden/
- **/.git.nested-bak/
